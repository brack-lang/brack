document = { stmt, '\n', '\n', { '\n' }}, [ stmt ], { '\n' }, ?EOF?;
stmt = (expr | bracket_close), { '\n', expr };
escaped = '\\', ['.' | ',' | bracket_open | bracket_close | '\\'];
expr = (escaped | module | ident | bracket | '.' | ',' | ' ' | text), {escaped | module | ident | bracket | '.' | ',' | ' ' | text};
bracket = angle | curly | square;
angle = '<', {expr | '\n'}, [bracket_close];
curly = '{', {expr | '\n'}, [bracket_close];
square = '[', {expr | '\n'}, [bracket_close];

bracket_open = '<' | '{' | '[';
bracket_close = '}' | ']' | '>';

module = text;
ident = text;

text = ? [^.]+ ?;
